# Copie ou preencha no recurso do painel no Coolify (nunca commite um .env real).

# === Obrigatório (autenticação e conexão com a ponte) ===
# Senha de acesso ao painel web (deixe vazio apenas se usar Google OAuth abaixo)
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Token compartilhado com o claude-zap (use o mesmo valor nas duas pontas)
BRIDGE_ADMIN_TOKEN=troque-por-um-token-longo-aleatorio
# URL interna ou pública da ponte claude-zap
# No stack único (docker-compose.stack.yml): http://claude-bridge:3000
# Em serviços separados no Coolify: http://claude-bridge-<nome>:3000
BRIDGE_URL=http://claude-bridge:3000

# === Opcional (recomendado em produção) ===
PORT=3001
# Segredo para assinar o cookie de sessão (opcional; derivado automaticamente se vazio)
SESSION_SECRET=
# URL pública do painel (usada em OAuth callback, links públicos de Mini-Apps e webhooks)
PUBLIC_URL=https://seu-painel.exemplo.com
# Contato VAPID para Web Push (aceita mailto:voce@exemplo.com ou https://seu-painel.exemplo.com)
VAPID_SUBJECT=

# === Opcional: Login com Google OAuth ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# E-mails autorizados separados por vírgula
ALLOWED_AUTH_EMAILS=

# === Opcional: Integração com a API do Coolify (aba Variáveis, Logs, Restart/Deploy do container da ponte) ===
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_APP_UUID=
